generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ──────────────────────────────────────────────────────────────────────────
// Auth.js (NextAuth) models
// ──────────────────────────────────────────────────────────────────────────

enum PlatformRole {
  USER
  ADMIN
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  platformRole  PlatformRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                Account[]
  sessions                Session[]
  workspaceMemberships    WorkspaceMember[]
  uploadedMedia           Media[]
  createdInvitations      Invitation[]             @relation("InvitationCreatedBy")
  createdVersions         InvitationVersion[]      @relation("VersionCreatedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ──────────────────────────────────────────────────────────────────────────
// Multi-tenant workspace
// ──────────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members      WorkspaceMember[]
  invitations  Invitation[]
  media        Media[]
  subscription Subscription?

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ──────────────────────────────────────────────────────────────────────────
// Invitations
// ──────────────────────────────────────────────────────────────────────────

enum EventType {
  WEDDING
  BIRTHDAY
  ENGAGEMENT
  ANNIVERSARY
  BABY_SHOWER
  CUSTOM
}

enum InvitationLifecycleStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum TemplateCategory {
  WEDDING
  BIRTHDAY
  LUXURY
  FLORAL
  MINIMAL
  MODERN
  TRADITIONAL
  KIDS
}

enum SectionType {
  HERO
  STORY
  EVENT_DETAILS
  GALLERY
  VENUE
  COUNTDOWN
  RSVP
  CUSTOM
}

model InvitationTemplate {
  id                 String           @id @default(cuid())
  name               String
  category           TemplateCategory
  eventTypes         Json // EventType[] serialized, MySQL has no native scalar list
  thumbnailUrl       String?
  isPremium          Boolean          @default(false)
  isActive           Boolean          @default(true)
  defaultSceneConfig Json // InvitationSceneConfig
  defaultSections    Json // InvitationSection[] seed content
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  invitations Invitation[]

  @@index([category])
  @@map("invitation_templates")
}

model Invitation {
  id          String                    @id @default(cuid())
  workspaceId String
  slug        String                    @unique
  eventType   EventType
  status      InvitationLifecycleStatus @default(DRAFT)

  title        String
  hostName     String?
  guestOfHonor String?
  description  String? @db.Text

  eventDate DateTime?
  startTime String?
  endTime   String?
  timezone  String?

  venue      String?
  address    String?
  mapUrl     String?
  directions String? @db.Text

  rsvpEnabled      Boolean   @default(true)
  rsvpDeadline     DateTime?
  maxGuestsPerRsvp Int       @default(1)
  mealOptions      Json?
  customQuestions  Json?

  templateId         String?
  publishedVersionId String? @unique
  coverImageId       String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template         InvitationTemplate? @relation(fields: [templateId], references: [id])
  createdBy        User                @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  coverImage       Media?              @relation("InvitationCoverImage", fields: [coverImageId], references: [id])
  publishedVersion InvitationVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  versions InvitationVersion[]      @relation("InvitationVersions")
  guests   Guest[]
  rsvps    Rsvp[]
  views    InvitationView[]
  gallery  InvitationGalleryImage[]

  @@index([workspaceId])
  @@index([status])
  @@map("invitations")
}

model InvitationGalleryImage {
  id           String @id @default(cuid())
  invitationId String
  mediaId      String
  order        Int    @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([invitationId, mediaId])
  @@index([invitationId])
  @@map("invitation_gallery_images")
}

model InvitationVersion {
  id            String                    @id @default(cuid())
  invitationId  String
  versionNumber Int
  status        InvitationLifecycleStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  invitation             Invitation  @relation("InvitationVersions", fields: [invitationId], references: [id], onDelete: Cascade)
  createdBy              User        @relation("VersionCreatedBy", fields: [createdById], references: [id])
  publishedForInvitation Invitation? @relation("PublishedVersion")

  sections InvitationSection[]
  scene    InvitationScene?

  @@unique([invitationId, versionNumber])
  @@index([invitationId])
  @@map("invitation_versions")
}

model InvitationSection {
  id        String      @id @default(cuid())
  versionId String
  type      SectionType
  order     Int         @default(0)
  content   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  version InvitationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("invitation_sections")
}

model InvitationScene {
  id        String   @id @default(cuid())
  versionId String   @unique
  sceneType String // "wedding" | "birthday" | "custom"
  config    Json // InvitationSceneConfig
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version InvitationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("invitation_scenes")
}

// ──────────────────────────────────────────────────────────────────────────
// Guests & RSVP
// ──────────────────────────────────────────────────────────────────────────

enum RsvpStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

model Guest {
  id            String    @id @default(cuid())
  invitationId  String
  name          String
  email         String?
  phone         String?
  groupName     String?
  allowedGuests Int       @default(1)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvp       Rsvp?

  @@index([invitationId])
  @@map("guests")
}

model Rsvp {
  id             String     @id @default(cuid())
  invitationId   String
  guestId        String?    @unique
  name           String
  email          String?
  phone          String?
  status         RsvpStatus
  numberOfGuests Int        @default(1)
  mealPreference String?
  message        String?    @db.Text
  answers        Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@map("rsvps")
}

// ──────────────────────────────────────────────────────────────────────────
// Media
// ──────────────────────────────────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  MODEL_3D
  TEXTURE
  FONT
}

model Media {
  id           String    @id @default(cuid())
  workspaceId  String
  uploadedById String
  type         MediaType
  url          String
  path         String
  filename     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  coverOfInvitations Invitation[]             @relation("InvitationCoverImage")
  galleryEntries     InvitationGalleryImage[]

  @@index([workspaceId])
  @@map("media")
}

// ──────────────────────────────────────────────────────────────────────────
// Analytics
// ──────────────────────────────────────────────────────────────────────────

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

enum RenderMode {
  THREE_D
  TWO_D_FALLBACK
}

model InvitationView {
  id             String     @id @default(cuid())
  invitationId   String
  sessionId      String
  deviceType     DeviceType @default(UNKNOWN)
  browser        String?
  country        String?
  referrer       String?
  webglSupported Boolean?
  renderMode     RenderMode @default(THREE_D)
  createdAt      DateTime   @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([invitationId, createdAt])
  @@map("invitation_views")
}

// ──────────────────────────────────────────────────────────────────────────
// Billing
// ──────────────────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Plan {
  id                  String   @id @default(cuid())
  tier                PlanTier @unique
  name                String
  priceMonthlyCents   Int
  priceYearlyCents    Int
  maxInvitations      Int // -1 = unlimited
  maxWorkspaceMembers Int
  features            Json
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  workspaceId        String             @unique
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
  invoices  Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  amountCents    Int
  currency       String        @default("usd")
  status         InvoiceStatus @default(OPEN)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  paidAt         DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([subscriptionId])
  @@map("invoices")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amountCents Int
  currency    String        @default("usd")
  status      PaymentStatus @default(PENDING)
  provider    String
  providerRef String?
  createdAt   DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}
